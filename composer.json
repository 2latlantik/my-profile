{
  "name": "2latlantik/my-profile",
  "type": "project",
  "description": "My profile source code",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-iconv": "*",
    "2latlantik/recaptcha": "dev-master",
    "2latlantik/rich-form-symfony": "^1.1",
    "antishov/doctrine-extensions-bundle": "^1.4",
    "doctrine/annotations": "1.14",
    "doctrine/doctrine-bundle": "^2",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^2",
    "symfony/apache-pack": "^1.0",
    "symfony/asset": "^5.4",
    "symfony/console": "^5.4",
    "symfony/debug-bundle": "^5.4",
    "symfony/expression-language": "^5.4",
    "symfony/filesystem": "^5.4",
    "symfony/flex": "^2.4",
    "symfony/form": "^5.4",
    "symfony/framework-bundle": "^5.4",
    "symfony/mailer": "^5.4",
    "symfony/maker-bundle": "^1.0",
    "symfony/monolog-bundle": "^3.0",
    "symfony/security-bundle": "^5.4",
    "symfony/stopwatch": "^5.4",
    "symfony/translation": "^5.4",
    "symfony/twig-bundle": "^5.4",
    "symfony/validator": "^5.4",
    "symfony/web-profiler-bundle": "^5.4",
    "symfony/webpack-encore-bundle": "^1.11",
    "symfony/yaml": "^5.4",
    "twig/extra-bundle": "^3.0",
    "twig/intl-extra": "^3.0"
  },
  "require-dev": {
    "2latlantik/symfony-my-cs": "dev-master",
    "doctrine/doctrine-fixtures-bundle": "^3.0",
    "symfony/dotenv": "^5.4",
    "symfony/phpunit-bridge": "^5.4",
    "symfony/var-dumper": "^5.4"
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": true
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php71": "*",
    "symfony/polyfill-php70": "*",
    "symfony/polyfill-php56": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "my-cs-install": [
      "SymfonyMyCs\\Git\\Hooks\\PostInstall::installHooks"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "id": "01C45GEECYPQR446X1PMD7J287",
      "allow-contrib": false,
      "require": "5.4.*"
    }
  }
}
